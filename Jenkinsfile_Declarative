@Library('mavenBuild_Library.groovy') _
pipeline{
    agent any
    triggers {
        githubPush()
         }
         options {
  buildDiscarder logRotator(numToKeepStr: '5')
}


    environment{
        Tomcat_Ip='13.203.227.129'
        SonarQube_Token=credentials('SonarQube')
       
    }
    tools{
        maven 'Maven-3.9.11'
    }
    stages{
        stage('Cloning the repo'){
            steps{
                git branch: 'development', credentialsId: 'Yashwanth_Studentwebapp', url: 'https://github.com/YashwanthRajamanickam/student-reg-webapp.git'
            }
        }
        stage('Building the package'){
            steps{
                building the package
            }
        }
         stage('Testing the package'){
            steps{
               sh "mvn sonar:sonar -Dsonar.token=${SonarQube_Token}" 
            }
         }
         stage('Deploying the package to Artifact repository'){
            steps{
               sh "mvn deploy"
            }
        }
         stage('deploying to Tomcat'){
            when {
                branch 'development'
            }
                steps{
                sshagent(['Tomcat']) {
               sh """
               echo 'Stopping the Tomcat Server'
               ssh -o StrictHostKeyChecking=no ec2-user@${Tomcat_Ip} 'cd /opt/tomcat/bin/ && sudo ./shutdown.sh'
               echo 'deploying the new war file'
               scp -o StrictHostKeyChecking=no target/student-reg-webapp.war ec2-user@${Tomcat_Ip}:/opt/tomcat/webapps/
               echo 'tarting the Tomcat Server'
               ssh -o StrictHostKeyChecking=no ec2-user@${Tomcat_Ip} 'cd /opt/tomcat/bin/ && sudo ./startup.sh'
                """
                }
            }
        }
         
         stage('for brannch feature-logs'){
                when {
                    branch 'feature-logs'
                }
                     steps{
                       sh " echo this is feature logs branch"
                }
            }
        
       stage('for brannch feature-main'){
                when {
                    branch 'feature-main'
                }
                     steps{
                       sh " echo this is feature main branch"
                }
            }
        
    }
    post{
        failure{
            script{
                 def buildStatus = currentBuild.currentResult
        slackSend channel: 'devops-operations', color: 'danger', message: "The Build for ${env.JOB_NAME} has been Failed and please check the logs on ${env.BUILD_URL} .More info-${env.BUILD_NUMBER} - ${env.JOB_NAME} - Build is ${buildStatus}"
    emailext (body: 
    """<p><b><span style="color:red;">Build Failure</span></b>.</p>
<p><b>Job</b> : "${env.JOB_NAME}</p>
<p><b>Build Number</b> : #${env.BUILD_NUMBER}</p>
<p><a href="${env.BUILD_URL}"> Click here to view the logs</a></p>""", subject: "Jenkins Build ${buildStatus} : ${env.JOB_NAME} #${env.BUILD_NUMBER}", to: 'yashwanthr2498@gmail.com',
mimeType: 'text/html'
    )
    }
        }
        success{
            script{
                 def buildStatus = currentBuild.currentResult
         slackSend(
    channel: 'devops-operations',
    color: 'good', // green sidebar
    message: "The Build for ${env.JOB_NAME} has been *PASSED*. Build is *${buildStatus}*. Check logs: <${env.BUILD_URL}|Click here>"
)
 emailext (body: 
    """<p><b><span style="color:green;">Build Success</span></b>.</p>
<p><b>Job</b> : "${env.JOB_NAME}</p>
<p><b>Build Number</b> : #${env.BUILD_NUMBER}</p>
<p><a href="${env.BUILD_URL}"> Click here to view the logs</a></p>""", subject: "Jenkins Build ${buildStatus} : ${env.JOB_NAME} #${env.BUILD_NUMBER}", to: 'yashwanthr2498@gmail.com',
mimeType: 'text/html'
    ) }
        }
        always{
            cleanWs()
        }

    }
    }
